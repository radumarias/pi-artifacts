    "worker/auth/access.ts",
    "worker/members.ts",
    "worker/queue.ts",
    "worker/chat-status.ts",
    "worker/agent/title.ts",
    "worker/chat-traces.ts",
    "worker/agent/skills.ts",
    "worker/models.ts",
    "worker/prices.json",
    "worker/agent/file-refs.ts",
    "worker/agent/mentions.ts",
    "worker/files-routes.ts",
    "worker/zip.ts",
    "worker/http.ts",
    "worker/skills/index.ts",
    "worker/raw.d.ts",
    "worker/artifacts/check.ts",
    "worker/agent/publish.ts",
    "worker/artifacts/serve.ts"
