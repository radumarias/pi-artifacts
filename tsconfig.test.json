    "scripts/prices.ts",
    "src/api.ts",
    "src/chat/Markdown.tsx",
    "src/chat/Thinking.tsx",
    "src/chat/Steps.tsx",
    "src/chat/Linkified.tsx",
    "src/files/highlight.ts",
    "src/files/preview.ts",
    "src/artifact/viewport.tsx",
    "src/Icon.tsx",
    "src/layout.tsx",
    "shared",
    "worker/mcp",
    "worker/agent/mcp.ts",
    "worker/agent/output.ts",
    "worker/agent/attachments.ts",
    "worker/storage/paths.ts",
    "worker/storage/artifacts.ts",
    "worker/storage/git.ts",
    "worker/storage/memory-fs.ts",
    "worker/storage/keys.ts",
    "worker/storage/user-files.ts",
    "worker/storage/drafts.ts",
